{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://badnight.local/contracts/game-api.schema.json",
  "title": "BadNight game API",
  "$defs": {
    "reference": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "gameView": {
      "type": "object",
      "properties": {
        "ok": { "const": true },
        "room": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "description": { "type": "string" }
          },
          "required": ["id", "name", "description"],
          "additionalProperties": false
        },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "ghosts": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "exits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "to": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "open": { "type": "boolean" }
            },
            "required": ["to", "name", "description", "open"],
            "additionalProperties": false
          }
        },
        "inventory": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "progress": {
          "type": "object",
          "properties": {
            "visited": { "type": "integer", "minimum": 1 },
            "total": { "type": "integer", "minimum": 1 }
          },
          "required": ["visited", "total"],
          "additionalProperties": false
        },
        "won": { "const": true }
      },
      "required": ["ok", "room", "objects", "ghosts", "exits", "inventory", "progress"],
      "additionalProperties": false
    },
    "createGameResponse": {
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "intro": { "type": "string" },
        "state": { "$ref": "#/$defs/gameView" }
      },
      "required": ["sessionId", "title", "intro", "state"],
      "additionalProperties": false
    },
    "turnRequest": {
      "type": "object",
      "properties": {
        "action": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
        "thinking": { "type": "string", "maxLength": 1000 }
      },
      "required": ["action"],
      "additionalProperties": false
    },
    "turnResponse": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/gameView" }
      },
      "required": ["text", "state"],
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "properties": { "error": { "type": "string" } },
      "required": ["error"],
      "additionalProperties": false
    }
  }
}
